# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini API Configuration (for voice assistant)
GEMINI_API_KEY=your_gemini_api_key

# Tavus API Configuration (for AI avatars)
TAVUS_API_KEY=your_tavus_api_key
VITE_TAVUS_EMERGENCY_REPLICA_ID=your_emergency_replica_id
VITE_TAVUS_AVATAR_REPLICA_ID=your_avatar_replica_id
VITE_TAVUS_HEALTH_REPLICA_ID=your_health_replica_id

# Configuration Notes:
# 
# 1. GEMINI_API_KEY and TAVUS_API_KEY should be set in Supabase Edge Function secrets:
#    - Go to your Supabase dashboard
#    - Navigate to Edge Functions > Settings
#    - Add these as secrets (not environment variables)
#
# 2. VITE_* variables should be set in your .env file (this file)
#
# 3. To get your Tavus replica IDs:
#    - Log in to your Tavus dashboard
#    - Go to the Replicas section
#    - Copy the replica ID for each avatar you want to use
#    - Replace the "your_*_replica_id" placeholders with actual IDs
#
# 4. Make sure your Tavus replicas are properly configured and active
#
# 5. Test your configuration by checking the browser console for any API errors